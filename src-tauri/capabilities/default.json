{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Knowwise 主窗口默认能力(M13 冻结)。业务全部走自定义命令;仅放行文件选择对话框、剪贴板写入与受控外部链接打开,不开放 shell/fs/http 直通。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "clipboard-manager:allow-write-text",
    "opener:allow-open-url"
  ]
}
